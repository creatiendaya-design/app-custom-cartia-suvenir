{
  "name": "souvenir-made-personalizer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --port 3000",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "preview:local": "node scripts/preview-local.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "shopify:dev": "npx --yes @shopify/cli app dev",
    "shopify:deploy": "npx --yes @shopify/cli app deploy"
  },
  "dependencies": {
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/shopify-api": "15.1.2",
    "@shopify/shopify-app-react-router": "4.0.4",
    "dotenv": "^17.2.3",
    "fflate": "^0.8.2",
    "isbot": "^5.1.31",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "sharp": "^0.34.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@react-router/dev": "7.18.2",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^3.2.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
