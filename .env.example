# Local pilot: enabled ONLY on loopback requests. Never enable on a public host.
LOCAL_DEMO=true
SHOPIFY_STORE_DOMAIN=souvenir-made-xbc1wrvr.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_products,read_orders,write_draft_orders
DATABASE_PATH=./data/souvenir.sqlite
# Local offline demo: sqlite. Render Free: set STORAGE_PROVIDER=supabase.
STORAGE_PROVIDER=sqlite
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=souvenir-assets
# Render: NODE_ENV=production, LOCAL_DEMO=false, STORAGE_PROVIDER=supabase.
# Shopify URL can be omitted on Render: RENDER_EXTERNAL_URL is used automatically.
